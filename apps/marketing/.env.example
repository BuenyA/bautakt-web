# Oeffentliche Adressen der beiden Deployments.
# ⚠️ Die Marketing-Seite hat bewusst KEINEN Supabase-Client und braucht daher
# weder URL noch Anon-Key. Auth lebt vollstaendig in apps/webapp.
#
# Pre-Domain-Cutover: Vercel-Aliase. Beim Go-live / Domain-Cutover durch
# https://bautakt.com bzw. https://app.bautakt.com in der Vercel-Env ersetzen
# und redeployen. NEXT_PUBLIC_* gewinnt ueber den Code-Fallback in lib/site.ts.
NEXT_PUBLIC_SITE_URL=https://bautakt-web-marketing.vercel.app
NEXT_PUBLIC_APP_URL=https://bautakt-webapp.vercel.app
