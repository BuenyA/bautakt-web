{
  "name": "bautakt-web",
  "private": true,
  "version": "1.0.0",
  "packageManager": "npm@11.6.4",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:marketing": "turbo run dev --filter=@bautakt/marketing",
    "dev:webapp": "turbo run dev --filter=@bautakt/webapp",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "turbo run lint typecheck && prettier --check ."
  },
  "devDependencies": {
    "@bautakt/eslint-config": "*",
    "@bautakt/tsconfig": "*",
    "@types/node": "^22",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "eslint": "^9.39.5",
    "prettier": "^3.6.2",
    "turbo": "^2.5.8",
    "typescript": "~5.9.3"
  }
}
