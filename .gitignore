# Abhaengigkeiten
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Env — niemals committen. Ausnahme: Beispiel und die pre-go-live
# Production-Alias-Datei der Marketing-App (nur oeffentliche URLs, keine Secrets).
.env
.env.*
!.env.example
!apps/marketing/.env.production

# Build-Ausgaben
.next/
out/
dist/
dist-ssr/
build/
*.local
*.tsbuildinfo
next-env.d.ts

# Tooling-Caches
.turbo/
coverage/

# Deployment
.vercel

# Die Supabase-CLI legt beim Generieren ein supabase/ mit Scratch-State an.
# Dieses Repo besitzt das Schema nicht — Migrationen leben in bautakt-app.
# Siehe AGENTS.md, Abschnitt "Repository relationship".
/supabase/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Betriebssystem / Editor
.DS_Store
*.pem
.idea/
.vscode/*
!.vscode/extensions.json
